{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asd-kontur:contracts:v2.1:schema:spine-contract-fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "session", "workspace", "document", "job", "event", "evidence", "mode", "knowledge_status", "error", "page", "capability_status", "capability_readiness_delta", "scale_qualification_results", "effective_registry_readiness"],
  "properties": {
    "contract_version": {"const": "2.1.0"},
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["owner_identity_id", "username", "profile", "absolute_expires_at"],
      "properties": {
        "owner_identity_id": {"type": "string", "minLength": 1},
        "username": {"type": "string", "minLength": 3},
        "profile": {"enum": ["development_loopback", "protected_remote"]},
        "absolute_expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "workspace": {"$ref": "#/$defs/workspace"},
    "document": {"$ref": "#/$defs/document"},
    "job": {"$ref": "#/$defs/job"},
    "event": {"$ref": "#/$defs/event"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "mode": {"$ref": "#/$defs/mode"},
    "knowledge_status": {"$ref": "#/$defs/knowledge"},
    "error": {"$ref": "#/$defs/error"},
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {"items": {"type": "array"}, "next_cursor": {"type": ["string", "null"]}}
    },
    "capability_status": {
      "type": "object", "additionalProperties": false,
      "required": ["slice", "implemented", "blockers", "trial_ready", "oks_ready", "product_ready"],
      "properties": {
        "slice": {"const": "PRODUCT-APPLICATION-SPINE-01"},
        "implemented": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "blockers": {"type": "array", "contains": {"const": "MEMORY_DATA_DEFECT"}},
        "trial_ready": {"const": false}, "oks_ready": {"const": false}, "product_ready": {"const": false}
      }
    },
    "capability_readiness_delta": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/readiness_delta"}
    },
    "scale_qualification_results": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/scale_result"}
    },
    "effective_registry_readiness": {
      "type": "object", "additionalProperties": false,
      "required": ["denominator", "NOT_IMPLEMENTED", "CONTRACT_ONLY", "FOUNDATION_ONLY", "PARTIAL", "CAPABILITY_READY", "MODE_READY", "TRIAL_READY", "PRODUCT_READY"],
      "properties": {
        "denominator": {"const": 142}, "NOT_IMPLEMENTED": {"const": 7},
        "CONTRACT_ONLY": {"const": 64}, "FOUNDATION_ONLY": {"const": 45},
        "PARTIAL": {"const": 10}, "CAPABILITY_READY": {"const": 16},
        "MODE_READY": {"const": 0}, "TRIAL_READY": {"const": 0},
        "PRODUCT_READY": {"const": 0}
      }
    }
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "workspace": {
      "type": "object", "additionalProperties": false,
      "required": ["organization_id", "workspace_id", "display_name", "lifecycle_state", "lifecycle_version"],
      "properties": {
        "organization_id": {"$ref": "#/$defs/uuid"}, "workspace_id": {"$ref": "#/$defs/uuid"},
        "display_name": {"type": "string"}, "lifecycle_state": {"type": "string"},
        "lifecycle_version": {"type": "integer", "minimum": 1}
      }
    },
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["document_id", "workspace_id", "active_version", "prior_versions", "job_ids", "media_type", "size_bytes", "sha256", "admission_status", "extraction_status", "capability_gaps"],
      "properties": {
        "document_id": {"$ref": "#/$defs/uuid"}, "workspace_id": {"$ref": "#/$defs/uuid"},
        "active_version": {"type": "integer", "minimum": 1},
        "prior_versions": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
        "job_ids": {"type": "array", "items": {"$ref": "#/$defs/uuid"}, "uniqueItems": true},
        "media_type": {"type": "string"}, "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/digest"}, "admission_status": {"type": "string"},
        "extraction_status": {"type": "string"}, "capability_gaps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "job": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "workspace_id", "kind", "state", "attempt_count", "lease_generation", "idempotency_key", "terminal_receipt"],
      "properties": {
        "job_id": {"$ref": "#/$defs/uuid"}, "workspace_id": {"$ref": "#/$defs/uuid"},
        "kind": {"enum": ["DOCUMENT_ADMISSION", "DOCUMENT_HASH", "PDF_INVENTORY", "NATIVE_TEXT_EXTRACTION", "EVIDENCE_INDEX_UPDATE", "WORKSPACE_RESET_RECONCILIATION"]},
        "state": {"enum": ["queued", "leased", "running", "succeeded", "failed", "cancelled", "reconciliation_required"]},
        "attempt_count": {"type": "integer", "minimum": 0}, "lease_generation": {"type": "integer", "minimum": 0},
        "idempotency_key": {"type": "string", "minLength": 1}, "terminal_receipt": {"type": ["string", "null"]}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "sequence", "event_type", "terminal"],
      "properties": {"job_id": {"$ref": "#/$defs/uuid"}, "sequence": {"type": "integer", "minimum": 1}, "event_type": {"type": "string"}, "terminal": {"type": "boolean"}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source_version_id", "page_number", "region", "evidence_digest", "authority_type", "uncertainty", "quarantined"],
      "properties": {
        "source_version_id": {"$ref": "#/$defs/uuid"}, "page_number": {"type": "integer", "minimum": 1},
        "region": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}], "items": false},
        "evidence_digest": {"$ref": "#/$defs/digest"}, "authority_type": {"type": "string"},
        "uncertainty": {"type": "array", "items": {"type": "string"}}, "quarantined": {"type": "boolean"}
      }
    },
    "mode": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "readiness", "missing_capabilities", "gaps"],
      "properties": {"mode": {"enum": ["Tender", "Support", "Audit", "Restoration"]}, "readiness": {"enum": ["FOUNDATION_ONLY", "PARTIAL"]}, "missing_capabilities": {"type": "array", "minItems": 1}, "gaps": {"type": "array", "minItems": 1}}
    },
    "knowledge": {
      "type": "object", "additionalProperties": false,
      "required": ["memory_data_defect", "verified_ntd_edition_count", "rule_version_count", "knowledge_ready", "blockers"],
      "properties": {"memory_data_defect": {"const": true}, "verified_ntd_edition_count": {"type": "integer", "minimum": 0}, "rule_version_count": {"type": "integer", "minimum": 0}, "knowledge_ready": {"const": false}, "blockers": {"type": "array", "contains": {"const": "MEMORY_DATA_DEFECT"}}}
    },
    "readiness_delta": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_id", "prior", "current", "evidence"],
      "properties": {
        "capability_id": {"type": "string", "minLength": 1},
        "prior": {"enum": ["NOT_IMPLEMENTED", "CONTRACT_ONLY", "FOUNDATION_ONLY", "PARTIAL", "CAPABILITY_READY"]},
        "current": {"enum": ["PARTIAL", "CAPABILITY_READY"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "scale_result": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "accepted", "rejected", "jobs", "lost_jobs", "threshold_status"],
      "properties": {
        "profile": {"enum": ["synthetic-content-minimal-1000", "synthetic-content-minimal-5000", "synthetic-content-minimal-10000"]},
        "accepted": {"enum": [1000, 5000, 10000]},
        "rejected": {"const": 0},
        "jobs": {"enum": [5000, 25000, 50000]},
        "lost_jobs": {"const": 0},
        "threshold_status": {"const": "UNSET_MEASURED_ONLY"}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "correlation_id"],
      "properties": {"code": {"type": "string", "minLength": 1}, "correlation_id": {"$ref": "#/$defs/uuid"}}
    }
  }
}
