{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asd-kontur:contracts:v2.3:schema:capability-registry-extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "base_registry", "base_denominator", "additions", "denominator", "readiness_distribution"],
  "properties": {
    "contract_version": {"const": "2.3.0"},
    "base_registry": {"const": "contracts/v2.0/fixtures/valid/product-capability-registry.json"},
    "base_denominator": {"const": 142},
    "denominator": {"const": 143},
    "readiness_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CAPABILITY_READY", "PARTIAL", "FOUNDATION_ONLY", "CONTRACT_ONLY", "NOT_IMPLEMENTED"],
      "properties": {
        "CAPABILITY_READY": {"const": 16},
        "PARTIAL": {"const": 10},
        "FOUNDATION_ONLY": {"const": 45},
        "CONTRACT_ONLY": {"const": 64},
        "NOT_IMPLEMENTED": {"const": 8}
      }
    },
    "additions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "name", "plane", "product_modes", "dependencies", "current_readiness", "legacy_decision", "target_implementation", "authentication_architecture", "architecture_security_adr_required", "issue_url", "known_gaps", "acceptance_criteria", "required_for_product"],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "name": {"type": "string", "minLength": 1},
        "plane": {"const": "field-offline"},
        "product_modes": {
          "type": "array",
          "uniqueItems": true,
          "contains": {"const": "Support"},
          "items": {"enum": ["Tender", "Support", "Audit", "Restoration"]}
        },
        "dependencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "current_readiness": {"const": "NOT_IMPLEMENTED"},
        "legacy_decision": {"const": "USE_AS_REFERENCE_ONLY"},
        "target_implementation": {"const": "REIMPLEMENT_FROM_SEMANTICS"},
        "authentication_architecture": {"const": "UNDECIDED"},
        "architecture_security_adr_required": {"const": true},
        "issue_url": {"type": "string", "format": "uri"},
        "known_gaps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "required_for_product": {"const": true}
      }
    }
  }
}
