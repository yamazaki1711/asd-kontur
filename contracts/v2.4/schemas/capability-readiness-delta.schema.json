{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asd-kontur:contracts:v2.4:schema:capability-readiness-delta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "base_current_state",
    "base_extension",
    "denominator",
    "readiness_delta",
    "effective_distribution",
    "trial_ready",
    "oks_ready",
    "product_ready"
  ],
  "properties": {
    "contract_version": {"const": "2.4.0"},
    "base_current_state": {
      "const": "contracts/v2.2/fixtures/valid/capability-current-state.json"
    },
    "base_extension": {
      "const": "contracts/v2.3/fixtures/valid/capability-registry-extension.json"
    },
    "denominator": {"const": 143},
    "readiness_delta": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "prior",
          "current",
          "evidence",
          "remaining_gaps"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "prior": {
            "enum": ["NOT_IMPLEMENTED", "CONTRACT_ONLY", "FOUNDATION_ONLY"]
          },
          "current": {"const": "PARTIAL"},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "remaining_gaps": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "effective_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CAPABILITY_READY",
        "PARTIAL",
        "FOUNDATION_ONLY",
        "CONTRACT_ONLY",
        "NOT_IMPLEMENTED"
      ],
      "properties": {
        "CAPABILITY_READY": {"const": 16},
        "PARTIAL": {"const": 28},
        "FOUNDATION_ONLY": {"const": 40},
        "CONTRACT_ONLY": {"const": 52},
        "NOT_IMPLEMENTED": {"const": 7}
      }
    },
    "trial_ready": {"const": false},
    "oks_ready": {"const": false},
    "product_ready": {"const": false}
  }
}
