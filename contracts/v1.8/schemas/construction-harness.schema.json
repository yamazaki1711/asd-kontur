{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asd-kontur:contracts:v1.8:schema:construction-harness",
  "title": "ASD-KONTUR unified construction harness",
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_version_id", "locator", "content_digest", "evidence_link_id"],
      "properties": {
        "source_version_id": {"$ref": "#/$defs/uuid"},
        "locator": {"type": "string", "minLength": 1},
        "content_digest": {"$ref": "#/$defs/digest"},
        "evidence_link_id": {"$ref": "#/$defs/uuid"}
      }
    },
    "workPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_package_id", "work_type_key", "work_type_version", "title", "quantities", "materials", "normative_references"],
      "properties": {
        "work_package_id": {"$ref": "#/$defs/uuid"},
        "work_type_key": {"type": "string", "minLength": 1},
        "work_type_version": {"type": "string", "minLength": 1, "not": {"pattern": "(?i)^latest$"}},
        "title": {"type": "string", "minLength": 1},
        "quantities": {"type": "array", "minItems": 1},
        "materials": {"type": "array"},
        "normative_references": {"type": "array"}
      }
    },
    "verticalFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "schema_id", "workspace_id", "work_packages", "matrix", "context_pack", "mode_views", "automatic_rule_promotion"],
      "properties": {
        "contract_version": {"const": "1.8.0"},
        "schema_id": {"const": "urn:asd-kontur:contracts:v1.8:schema:construction-harness"},
        "workspace_id": {"$ref": "#/$defs/uuid"},
        "work_packages": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/workPackage"}
        },
        "matrix": {
          "type": "object",
          "required": ["matrix_id", "version", "fingerprint", "work_package_ids"],
          "properties": {
            "matrix_id": {"$ref": "#/$defs/uuid"},
            "version": {"type": "integer", "minimum": 1},
            "fingerprint": {"$ref": "#/$defs/digest"},
            "work_package_ids": {"type": "array", "minItems": 3, "uniqueItems": true}
          }
        },
        "context_pack": {
          "type": "object",
          "required": ["workspace_facts", "methodological_practice", "normative_authority", "deterministic_rules", "knowledge_gaps", "evidence"],
          "properties": {
            "workspace_facts": {"type": "array", "minItems": 1},
            "methodological_practice": {"type": "array"},
            "normative_authority": {"type": "array"},
            "deterministic_rules": {"type": "array"},
            "knowledge_gaps": {"type": "array"},
            "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceEvidence"}}
          }
        },
        "mode_views": {
          "type": "object",
          "additionalProperties": false,
          "required": ["Tender", "Support", "Audit", "Restoration"],
          "properties": {
            "Tender": {"type": "object", "required": ["quantity_or_material_delta", "unresolved_ntd"]},
            "Support": {"type": "object", "required": ["id_requirements"]},
            "Audit": {"type": "object", "required": ["missing_or_incomplete"]},
            "Restoration": {"type": "object", "required": ["recoverable", "non_recoverable", "fabrication_prohibited"]}
          }
        },
        "automatic_rule_promotion": {"const": false}
      }
    },
    "customerAddition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "document_requirement_id", "target_authority_status", "additional_copies", "additional_evidence_kinds"],
      "properties": {
        "workspace_id": {"$ref": "#/$defs/uuid"},
        "document_requirement_id": {"$ref": "#/$defs/uuid"},
        "target_authority_status": {"const": "normative_verified"},
        "additional_copies": {"type": "integer", "minimum": 0},
        "additional_evidence_kinds": {"type": "array", "items": {"type": "string"}}
      },
      "anyOf": [
        {"properties": {"additional_copies": {"minimum": 1}}},
        {"properties": {"additional_evidence_kinds": {"minItems": 1}}}
      ]
    },
    "gatewayRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "contract_version", "schema_id", "schema_version", "payload"],
      "properties": {
        "tool": {"enum": ["knowledge.get_construction_harness_context", "knowledge.trace_work_requirement"]},
        "contract_version": {"const": "1.8.0"},
        "schema_id": {"const": "urn:asd-kontur:contracts:v1.8:schema:construction-harness"},
        "schema_version": {"const": "1.8.0"},
        "payload": {"type": "object", "required": ["context_pack_id"], "properties": {"context_pack_id": {"$ref": "#/$defs/uuid"}}}
      }
    }
  }
}
